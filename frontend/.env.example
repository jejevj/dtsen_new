# Gunakan path relatif agar nginx di production bisa proxy ke backend container
# Development lokal: ganti ke http://localhost:5000/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=DTSEN
VITE_APP_VERSION=2.0.0
VITE_USE_MOCK=false

# View-only protection:
# true  = disable klik kanan, text select, devtools shortcuts, drag
# false = normal (gunakan false saat development)
VITE_VIEW_ONLY=true
