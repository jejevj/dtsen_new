# Flask
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=ganti-dengan-secret-yang-kuat

# JWT
JWT_SECRET_KEY=ganti-dengan-jwt-secret-yang-kuat
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database — sesuaikan dengan koneksi production
DATABASE_URL=mysql+pymysql://user:password@host:3306/db_simzat

# CORS — karena pakai nginx proxy, cukup allow frontend container
CORS_ORIGINS=http://localhost,http://dtsen_frontend

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
